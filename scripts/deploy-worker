#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
mkdir -p "$scratch/worker"
cp railway.json "$scratch/"
cp worker/*.py worker/*.json worker/*.txt "$scratch/worker/"
cp worker/Dockerfile "$scratch/Dockerfile"
railway up "$scratch" --path-as-root --service commondesk-worker --environment production --detach
