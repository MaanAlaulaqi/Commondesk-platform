#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
mkdir -p "$scratch/worker" "$scratch/translator/coached-build"
model_args=("$scratch/translator/coached-build")
if [[ -n "${MT_COACHED_SOURCE:-}" ]]; then model_args+=("$MT_COACHED_SOURCE"); fi
"${HF_PYTHON:-python3}" translator/prepare_coached.py "${model_args[@]}"
cp translator/{runtime.py,requirements.txt,fetch_control.py,prepare_coached.py,control.json,observation-policy.json,coached-ar-en.json,coached-ar-en-policy.json} "$scratch/translator/"
cp worker/*.py worker/*.json worker/*.txt "$scratch/worker/"
cp worker/Dockerfile "$scratch/Dockerfile"
railway up "$scratch" --path-as-root --service commondesk-worker --environment production --detach
